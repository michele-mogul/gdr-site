---
/**
 * Creature or NPC block. Usable from any .mdx file without importing it:
 * the entry layout passes it to <Content components={...} />.
 *
 *   <Statblock name="Ratto gigante" meta="Bestia, taglia piccola"
 *              stats={{ CA: 12, PF: 7, Velocità: "9 m" }}>
 *     Morso +3, 1d6 danni.
 *   </Statblock>
 *
 * The stat labels are whatever you type: they are content, not code.
 */
interface Props {
  name: string;
  /** Short line under the name: type, size, alignment... */
  meta?: string;
  stats: Record<string, string | number>;
}

const { name, meta, stats } = Astro.props;
const entries = Object.entries(stats);
---

<aside class="not-prose border-rule my-10 border-l-2 pl-5">
  <p class="font-meta text-meta text-accent-dim tracking-[0.16em] uppercase">Statblock</p>
  <h3 class="text-section mt-1 font-normal">{name}</h3>
  {meta && <p class="text-ink-muted mt-1 italic">{meta}</p>}

  <dl class="font-meta text-meta text-ink-muted mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
    {
      entries.map(([label, value]) => (
        <>
          <dt class="text-ink-faint uppercase">{label}</dt>
          <dd class="text-ink">{value}</dd>
        </>
      ))
    }
  </dl>

  {
    Astro.slots.has('default') && (
      <div class="border-rule-faint text-ink-muted mt-4 border-t pt-4">
        <slot />
      </div>
    )
  }
</aside>
