---
import { GISCUS } from '../config';

/**
 * Giscus, kept in one switchable place: with `GISCUS.enabled: false` this
 * renders nothing at all — no markup, no script, no third-party request.
 *
 * When enabled the widget is still not loaded on page load: an
 * IntersectionObserver injects it when the container scrolls into view, which
 * is the `client:visible` behaviour without pulling in a UI framework.
 *
 * The widget also follows the site's light/dark switch, via the `themechange`
 * event dispatched by ThemeToggle.
 */
const {
  enabled,
  repo,
  repoId,
  category,
  categoryId,
  mapping,
  inputPosition,
  themeLight,
  themeDark,
  lang,
} = GISCUS;
const configured = enabled && repoId !== '' && categoryId !== '';
---

{
  configured && (
    <section class="border-rule-faint mt-20 border-t pt-10" aria-label="Commenti">
      <h2 class="font-meta text-meta text-ink-faint mb-6 tracking-[0.18em] uppercase">Commenti</h2>
      <div
        id="giscus"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping={mapping}
        data-input-position={inputPosition}
        data-theme-light={themeLight}
        data-theme-dark={themeDark}
        data-lang={lang}
      />
      {/* is:inline keeps this out of the global bundle: with comments off, no page ships a single byte of it. */}
      <script is:inline>
        (() => {
          const mount = document.getElementById('giscus');
          if (!mount) return;

          const isLight = () =>
            (document.documentElement.dataset.theme ??
              (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')) ===
            'light';

          const giscusTheme = () =>
            isLight()
              ? (mount.dataset.themeLight ?? 'light')
              : (mount.dataset.themeDark ?? 'transparent_dark');

          const load = () => {
            const script = document.createElement('script');
            script.src = 'https://giscus.app/client.js';
            script.async = true;
            script.crossOrigin = 'anonymous';
            script.setAttribute('data-repo', mount.dataset.repo ?? '');
            script.setAttribute('data-repo-id', mount.dataset.repoId ?? '');
            script.setAttribute('data-category', mount.dataset.category ?? '');
            script.setAttribute('data-category-id', mount.dataset.categoryId ?? '');
            script.setAttribute('data-mapping', mount.dataset.mapping ?? 'pathname');
            script.setAttribute('data-reactions-enabled', '1');
            script.setAttribute('data-emit-metadata', '0');
            script.setAttribute('data-input-position', mount.dataset.inputPosition ?? 'bottom');
            script.setAttribute('data-theme', giscusTheme());
            script.setAttribute('data-lang', mount.dataset.lang ?? 'it');
            script.setAttribute('data-loading', 'lazy');
            mount.appendChild(script);
          };

          const observer = new IntersectionObserver((entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              observer.disconnect();
              load();
            }
          });

          observer.observe(mount);

          // Repaint the widget when the site theme changes. The iframe only
          // exists once Giscus has loaded, so this is a no-op before that.
          document.addEventListener('themechange', () => {
            const frame = document.querySelector('iframe.giscus-frame');
            if (!frame || !frame.contentWindow) return;
            frame.contentWindow.postMessage(
              { giscus: { setConfig: { theme: giscusTheme() } } },
              'https://giscus.app',
            );
          });
        })();
      </script>
    </section>
  )
}
