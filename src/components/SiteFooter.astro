---
import { SITE } from '../config';
import { href } from '../lib/href';
---

<footer class="border-t border-rule-faint mt-24">
  <div
    class="font-meta text-meta text-ink-faint mx-auto flex max-w-(--measure-wide) flex-wrap justify-between gap-4 px-5 py-8"
  >
    <p>{SITE.copyright}</p>
    <p class="flex gap-4">
      <a href={href("/rss.xml")}>RSS</a>
      <a href={href("/sitemap-index.xml")}>Sitemap</a>
    </p>
  </div>
</footer>
