---
import type { ImageMetadata } from 'astro';
import { COLLECTIONS, COLLECTION_META, SITE } from '../config';

interface Props {
  title: string;
  description: string;
  /** Falls back to no image at all: never ship a generic placeholder. */
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'article';
  publishedDate?: Date | undefined;
  tags?: readonly string[] | undefined;
  /** Keeps drafts and tag pages out of the index. */
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  publishedDate,
  tags,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site ?? SITE.url);
const socialImage = image ? new URL(image.src, Astro.site ?? SITE.url) : undefined;
const fullTitle = canonical.pathname === '/' ? SITE.title : `${title} — ${SITE.title}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="it_IT" />
{socialImage && <meta property="og:image" content={socialImage.href} />}
{socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{image && <meta property="og:image:width" content={String(image.width)} />}
{image && <meta property="og:image:height" content={String(image.height)} />}

<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{(tags ?? []).map((tag) => <meta property="article:tag" content={tag} />)}

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — tutto`} href="/rss.xml" />
{
  COLLECTIONS.map((collection) => (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — ${COLLECTION_META[collection].plural}`}
      href={`/${COLLECTION_META[collection].path}/rss.xml`}
    />
  ))
}
