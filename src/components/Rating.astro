---
interface Props {
  /** 1 to 5, half points allowed. */
  value: number;
}

const { value } = Astro.props;
const pips = [1, 2, 3, 4, 5];
const label = `${value.toString().replace('.', ',')} su 5`;
---

<span class="font-meta text-meta inline-flex items-center gap-2" aria-label={label} title={label}>
  <span aria-hidden="true" class="inline-flex gap-0.5">
    {
      pips.map((pip) => (
        <span
          class:list={[
            'inline-block h-2.5 w-2.5 border',
            value >= pip
              ? 'border-accent bg-accent'
              : value >= pip - 0.5
                ? 'border-accent bg-linear-[90deg,var(--color-accent)_50%,transparent_50%]'
                : 'border-rule',
          ]}
        />
      ))
    }
  </span>
  <span class="text-ink-faint">{value.toString().replace('.', ',')}/5</span>
</span>
